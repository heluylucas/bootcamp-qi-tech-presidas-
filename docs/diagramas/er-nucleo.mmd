---
config:
  theme: base
  themeVariables:
    primaryColor: "#eef3fb"
    primaryBorderColor: "#2f5f9e"
    primaryTextColor: "#10233f"
    lineColor: "#2f5f9e"
    secondaryColor: "#f7f9fd"
    tertiaryColor: "#ffffff"
    noteBkgColor: "#f7f9fd"
    noteBorderColor: "#2f5f9e"
    noteTextColor: "#10233f"
  layout: elk
  elk:
    mergeEdges: false
    nodePlacementStrategy: NETWORK_SIMPLEX
---
erDiagram
    customer |o--o{ account : "tem (1 não encerrada); a do banco não tem cliente"
    account ||--o{ account_status_event : "trilha de estados"
    account ||--o{ transaction : "dona do pedido"
    account |o--o{ transaction : "destino (só transferência)"
    transaction ||--|{ ledger_entry : "1 lançamento (4 na transferência)"
    account ||--o{ ledger_entry : "lançamentos"

    customer {
        int id PK "interno, nunca sai"
        char customer_key UK "sai na API (uuid4)"
        text name
        char document_number UK "CPF normalizado"
        date birth_date
        timestamptz created_at
    }
    account {
        int id PK "a do banco é a 1"
        char account_key UK
        int customer_id FK "nulo só na conta do banco; UK parcial se não CLOSED"
        account_status status "ENUM: ACTIVE | BLOCKED | CLOSED"
        bigint balance "centavos, CHECK >= 0"
        timestamptz created_at
        timestamptz updated_at
    }
    account_status_event {
        int id PK
        int account_id FK
        account_status from_status "ENUM: ACTIVE | BLOCKED | CLOSED; nulo no nascimento"
        account_status to_status "ENUM: ACTIVE | BLOCKED | CLOSED"
        varchar reason
        status_actor actor "ENUM: CUSTOMER | BANK"
        timestamptz created_at
    }
    transaction {
        int id PK
        char transaction_key UK
        transaction_type type "ENUM: DEPOSIT | WITHDRAWAL | TRANSFER | INVESTMENT_APPLY | INVESTMENT_REDEEM"
        int owner_account_id FK "dona do pedido"
        int destination_account_id FK "só e sempre na TRANSFER"
        bigint amount "centavos, > 0"
        bigint fee_amount "tarifa cobrada"
        varchar description
        uuid idempotency_key UK "do cliente; nula na liquidação"
        date business_date FK "o dia no calendário do banco"
        timestamptz created_at
    }
    ledger_entry {
        int id PK
        int transaction_id FK
        int account_id FK
        entry_direction direction "ENUM: DEBIT | CREDIT"
        entry_category category "ENUM: PRINCIPAL | FEE"
        bigint amount
        bigint balance_after "saldo depois, >= 0"
        timestamptz created_at
    }
