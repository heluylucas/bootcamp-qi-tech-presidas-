erDiagram
    customer ||--o{ account : "tem (1 não encerrada)"
    account_status ||--o{ account : "estado atual"
    account ||--o{ account_status_event : "trilha de estados"
    account_status ||--o{ account_status_event : "de / para"
    transaction_type ||--o{ transaction : "tipo"
    account ||--o{ transaction : "pede"
    transaction ||--|{ ledger_entry : "gera 1 a 3"
    account ||--o{ ledger_entry : "lançamentos"

    customer {
        int id PK "interno, nunca sai"
        char customer_key UK "sai na API (uuid4)"
        char document_number UK "CPF normalizado"
        date birth_date
        timestamptz created_at
    }
    account {
        int id PK
        char account_key UK
        int customer_id FK "UK parcial se não CLOSED"
        int status_id FK
        bigint balance "centavos, CHECK >= 0"
        timestamptz updated_at
    }
    account_status {
        int id PK
        string enumerator UK "ACTIVE, BLOCKED, CLOSED"
    }
    account_status_event {
        int id PK
        int account_id FK
        int from_status_id FK "nulo no nascimento"
        int to_status_id FK
        string reason
        timestamptz created_at
    }
    transaction_type {
        int id PK
        string enumerator UK "DEPOSIT ... INVESTMENT_REDEEM"
    }
    transaction {
        int id PK
        char transaction_key UK
        int type_id FK
        int requester_account_id FK "UK com idempotency_key"
        int origin_account_id FK "nulo no depósito"
        int destination_account_id FK "nulo no saque"
        bigint amount "centavos, > 0"
        bigint fee_amount "tarifa cobrada"
        char idempotency_key
        char request_hash "SHA-256 do corpo"
        timestamptz created_at
    }
    ledger_entry {
        int id PK
        char entry_key UK
        int transaction_id FK
        int account_id FK
        string direction "DEBIT ou CREDIT"
        string category "PRINCIPAL ou FEE"
        bigint amount
        bigint balance_after "saldo depois, >= 0"
        timestamptz created_at
    }
