---
config:
  layout: elk
  elk:
    mergeEdges: false
    nodePlacementStrategy: NETWORK_SIMPLEX
---
erDiagram
    product ||--o{ product_price : "preço por dia"
    transaction ||--o| investment_order : "o pedido de dinheiro da ordem"
    product ||--o{ investment_order : "negociado"
    investment_order |o--o| investment_order : "liquidação devolve"
    account ||--o{ position : "possui"
    product ||--o{ position : "em"

    product {
        int id PK
        char product_key UK
        varchar name
        product_type type "PUBLIC_BOND, PRIVATE_BOND, FUND"
        varchar issuer
        product_indexer indexer "SELIC, CDI, PREFIXED, IPCA, QUOTA"
        varchar rate_description
        smallint risk_level "1 a 5"
        smallint term_months "prazo por aplicação ou nulo"
        bigint minimum_application_amount
        smallint cdi_percentage_bps
        smallint administration_fee_bps
        varchar price_source_code "nome na fonte externa; nulo = emissão própria"
        timestamptz created_at
    }
    product_price {
        int id PK
        int product_id FK "UK com price_date"
        date price_date
        numeric unit_price "NUMERIC(20,8)"
        timestamptz created_at
    }
    business_day {
        int id PK
        date business_date UK "maior = data de movimento"
        timestamptz created_at
    }
    reference_rate {
        int id PK
        reference_rate_code code "CDI ou SELIC, UK com data"
        date rate_date
        int annual_rate_bps
        timestamptz created_at
    }
    investment_order {
        int id PK
        char order_key UK
        int transaction_id FK "UK; dono, lado, valor e chave vêm dela"
        int product_id FK
        numeric quantity "NUMERIC(24,8)"
        numeric unit_price "NUMERIC(20,8)"
        bigint acquisition_cost_amount
        boolean redeem_all "o cliente pediu resgate total"
        date maturity_date "só aplicação com prazo"
        int matured_investment_order_id FK "UK; só na liquidação do vencimento"
        timestamptz created_at
    }
    position {
        int id PK
        int account_id FK "UK com product_id"
        int product_id FK
        numeric quantity ">= 0, zerada não some"
        bigint acquisition_cost_amount "custo médio"
        timestamptz created_at
        timestamptz updated_at
    }
