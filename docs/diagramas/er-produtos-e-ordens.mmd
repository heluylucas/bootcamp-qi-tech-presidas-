erDiagram
    product_type ||--o{ product : "tipo"
    product ||--o{ product_price : "preço por dia"
    customer ||--o{ investment_order : "envia"
    account ||--o{ investment_order : "paga / recebe"
    product ||--o{ investment_order : "negociado"
    transaction ||--o| investment_order : "movimento de dinheiro"
    investment_order |o--o| investment_order : "liquidação devolve"
    customer ||--o{ position : "possui"
    product ||--o{ position : "em"

    product_type {
        int id PK
        string enumerator UK "PUBLIC_BOND, PRIVATE_BOND, FUND"
    }
    product {
        int id PK
        char product_key UK
        int type_id FK
        smallint risk_level "1 a 5"
        string liquidity "DAILY ou AT_MATURITY"
        date maturity_date "vencimento fixo ou nulo"
        smallint term_months "prazo por aplicação ou nulo"
        boolean tax_exempt "CHECK prazo >= 9 meses"
        bigint min_application
        smallint cdi_percentage_bps
        smallint admin_fee_bps
        string external_code "nome na fonte externa"
    }
    product_price {
        int id PK
        int product_id FK "UK com reference_date"
        date reference_date
        numeric unit_price "NUMERIC(20,8)"
    }
    business_day {
        int id PK
        date reference_date UK "maior = data de movimento"
    }
    reference_rate {
        int id PK
        string code "CDI ou SELIC, UK com data"
        date reference_date
        int annual_rate_bps
    }
    investment_order {
        int id PK
        char order_key UK
        int customer_id FK "UK com idempotency_key"
        int account_id FK
        int product_id FK
        int transaction_id FK "UK"
        string side "APPLY ou REDEEM"
        bigint amount
        numeric quantity "NUMERIC(24,8)"
        numeric unit_price
        bigint cost_amount
        date maturity_date "só aplicação com prazo"
        string source "CUSTOMER ou MATURITY"
        int settled_order_id FK "UK, aplicação liquidada"
        char idempotency_key
        char request_hash
        timestamptz created_at
    }
    position {
        int id PK
        int customer_id FK "UK com product_id"
        int product_id FK
        numeric quantity ">= 0, zerada não some"
        bigint invested_amount "custo médio"
        timestamptz updated_at
    }
