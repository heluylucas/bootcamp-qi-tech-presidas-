---
config:
  look: classic
  theme: base
  themeVariables:
    primaryColor: "#eef3fb"
    primaryBorderColor: "#2f5f9e"
    primaryTextColor: "#10233f"
    lineColor: "#2f5f9e"
    secondaryColor: "#f7f9fd"
    tertiaryColor: "#ffffff"
    noteBkgColor: "#f7f9fd"
    noteBorderColor: "#2f5f9e"
    noteTextColor: "#10233f"
  layout: elk
  elk:
    mergeEdges: false
    nodePlacementStrategy: NETWORK_SIMPLEX
---
erDiagram
    customer ||--o{ suitability_assessment : "responde"
    suitability_assessment ||--|{ suitability_answer : "7 respostas"
    suitability_question ||--|{ suitability_option : "4 opções"
    suitability_option ||--o{ suitability_answer : "escolhida"
    product ||--o{ model_portfolio_item : "compõe"

    suitability_question {
        int id PK
        varchar code UK "seed (não é ENUM): Q1 a Q7, ordem do questionário"
        text text
        varchar dimension
        timestamptz created_at
    }
    suitability_option {
        int id PK
        int suitability_question_id FK "UK com code"
        smallint code "1 a 4, também a pontuação"
        text text
        timestamptz created_at
    }
    suitability_assessment {
        int id PK
        char suitability_assessment_key UK
        int customer_id FK
        investor_profile investor_profile "ENUM: CONSERVATIVE | MODERATE | AGGRESSIVE; fora da faixa do score = trava (forced_by_rule)"
        smallint score
        timestamptz created_at "mais recente = vigente; vale 24 meses"
    }
    suitability_answer {
        int id PK
        int suitability_assessment_id FK "UK com suitability_option_id"
        int suitability_option_id FK "a pergunta vem da opção"
        timestamptz created_at
    }
    model_portfolio_item {
        int id PK
        investor_profile investor_profile "ENUM: CONSERVATIVE | MODERATE | AGGRESSIVE; UK com product_id"
        int product_id FK
        smallint weight_bps "a carteira soma 10000"
        timestamptz created_at
    }
