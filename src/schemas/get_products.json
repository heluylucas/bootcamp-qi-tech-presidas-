{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": ["PUBLIC_BOND", "PRIVATE_BOND", "FUND"]
    },
    "maximum_risk_level": {
      "type": "string",
      "pattern": "^[1-5]$"
    }
  }
}
