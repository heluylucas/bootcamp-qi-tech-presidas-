{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["status"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "BLOCKED", "CLOSED"]
    },
    "reason": {
      "type": "string",
      "maxLength": 255
    }
  }
}
