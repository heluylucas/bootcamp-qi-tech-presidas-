{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "page": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "limit": {
      "type": "string",
      "pattern": "^([1-9][0-9]?|100)$"
    },
    "product_key": {
      "type": "string",
      "maxLength": 36
    }
  }
}
