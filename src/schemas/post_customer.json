{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "document_number", "birth_date"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "pattern": "^\\S(.*\\S)?$"
    },
    "document_number": {
      "type": "string",
      "pattern": "^(\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}|\\d{11})$"
    },
    "birth_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
