{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "page": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "limit": {
      "type": "string",
      "pattern": "^([1-9]|[1-9][0-9]|100)$"
    },
    "type": {
      "type": "string",
      "enum": ["DEPOSIT", "WITHDRAWAL", "TRANSFER", "INVESTMENT_APPLY", "INVESTMENT_REDEEM"]
    },
    "from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "to": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
